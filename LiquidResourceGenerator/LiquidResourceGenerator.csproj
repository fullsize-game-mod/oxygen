<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LiquidResourceGenerator</AssemblyName>
    <RootNamespace>LiquidResourceGenerator</RootNamespace>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GameManagedPath Condition="'$(GameManagedPath)' == ''">$(ONI_MANAGED_PATH)</GameManagedPath>
    <ModOutputPath>$(MSBuildProjectDirectory)/../dist/LiquidResourceGenerator</ModOutputPath>
  </PropertyGroup>

  <!-- 游戏提供运行时依赖，安装包只包含本 Mod。 -->
  <ItemGroup>
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.2" PrivateAssets="all" ExcludeAssets="runtime" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameManagedPath)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(GameManagedPath)/Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManagedPath)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManagedPath)/UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameManagedPath)' == ''" Text="请通过 -p:GameManagedPath=游戏的Managed目录 或 ONI_MANAGED_PATH 环境变量指定游戏程序集。" />
    <Error Condition="!Exists('$(GameManagedPath)/Assembly-CSharp.dll') Or !Exists('$(GameManagedPath)/Assembly-CSharp-firstpass.dll')" Text="GameManagedPath 中缺少游戏程序集。" />
    <Error Condition="!Exists('$(GameManagedPath)/UnityEngine.dll') Or !Exists('$(GameManagedPath)/UnityEngine.CoreModule.dll')" Text="GameManagedPath 中缺少 Unity 程序集。" />
  </Target>

  <Target Name="PackageMod" AfterTargets="Build">
    <MakeDir Directories="$(ModOutputPath)" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)/mod.yaml;$(MSBuildProjectDirectory)/mod_info.yaml" DestinationFolder="$(ModOutputPath)" />
  </Target>
</Project>
